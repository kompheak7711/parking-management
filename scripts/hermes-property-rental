#!/bin/sh
set -eu

task_file="${1:-}"
manifest_file="${2:-}"
repo="${PROPERTY_RENTAL_REPO:-$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)}"
guard="$repo/scripts/openclaw_hermes_guard.py"
hermes_bin="${PROPERTY_RENTAL_HERMES_BIN:-hermes}"

[ "$#" -eq 2 ] && [ -f "$task_file" ] && [ -f "$manifest_file" ] || {
  echo "A compact task file and dispatcher-created invocation manifest are required" >&2
  exit 64
}
[ -x "$guard" ] || {
  echo "Repository-owned Hermes guard is unavailable" >&2
  exit 64
}

wrapper_parent_pid="${PPID:-}"
[ -n "$wrapper_parent_pid" ] || wrapper_parent_pid="$(ps -o ppid= -p "$$")" || {
    echo "Unable to determine the repository wrapper parent process" >&2
    exit 64
  }
PROPERTY_RENTAL_WRAPPER_PARENT_PID="$(printf '%s' "$wrapper_parent_pid" | tr -d '[:space:]')"
PROPERTY_RENTAL_WRAPPER_PID="$$"
export PROPERTY_RENTAL_WRAPPER_PARENT_PID
export PROPERTY_RENTAL_WRAPPER_PID

python3 "$guard" validate "$manifest_file" "$task_file" || exit 64

stage="$(jq -er '.stage' "$manifest_file")"
reasoning="$(jq -er '.token_policy.requested_reasoning' "$manifest_file")"
token_ceiling="$(jq -er '.token_policy.cumulative_ceiling' "$manifest_file")"
manifest_id="$(jq -er '.manifest_id' "$manifest_file")"
usage_file="$(jq -er '.usage_path' "$manifest_file")"
bounded_substage_id="$(jq -r '.bounded_substage_id // empty' "$manifest_file")"
state_root="$(CDPATH= cd -- "$(dirname "$manifest_file")/.." && pwd)"
session_home="$state_root/hermes-sessions/$manifest_id"
toolsets="file,terminal,todo"
[ -z "$bounded_substage_id" ] || toolsets="file,terminal"

[ "${PROPERTY_RENTAL_HERMES_STAGE:-$stage}" = "$stage" ] \
  && [ "${PROPERTY_RENTAL_HERMES_USAGE_FILE:-$usage_file}" = "$usage_file" ] \
  && [ "${PROPERTY_RENTAL_HERMES_TOKEN_CEILING:-$token_ceiling}" = "$token_ceiling" ] || {
  echo "Invocation environment differs from the dispatcher manifest" >&2
  exit 64
}

case "$stage:$reasoning:$token_ceiling" in
  implementation:high:60000|direct_codex_recovery:high:60000) ;;
  independent_review:xhigh:90000) ;;
  independent_review:xhigh:120000)
    jq -e '
      .token_policy.cumulative_ceiling == 120000
      and (.token_policy.exceptional_review_classification | type == "string" and length > 0)
      and (.preserved_worktree_fingerprint | type == "string" and length == 64)
    ' "$manifest_file" >/dev/null || {
      echo "120000-token review requires persisted exceptional classification evidence" >&2
      exit 64
    }
    ;;
  *)
    echo "Unsupported Hermes stage, reasoning, or cumulative token policy" >&2
    exit 64
    ;;
esac

PROPERTY_RENTAL_HERMES_SOURCE_HOME="${PROPERTY_RENTAL_HERMES_SOURCE_HOME:-$HOME/.hermes}" \
  python3 "$guard" prepare-home "$manifest_file" "$task_file" "$session_home" || exit 64

export HERMES_HOME="$session_home"
export HERMES_ENABLE_PROJECT_PLUGINS=1
export PROPERTY_RENTAL_INVOCATION_MANIFEST="$manifest_file"
export PROPERTY_RENTAL_REPO="$repo"
export HERMES_MAX_TOKENS="$token_ceiling"

# A large, read-only xhigh review can legitimately spend more than ten minutes
# reasoning before the Codex backend returns its first non-streaming response.
# Keep implementation on Hermes' normal stale-call policy; extend only the
# already-bounded independent-review transport wait. This does not change any
# model token ceiling or request timeout.
unset HERMES_API_CALL_STALE_TIMEOUT
if [ "$stage" = "independent_review" ]; then
  HERMES_API_CALL_STALE_TIMEOUT=1200
  export HERMES_API_CALL_STALE_TIMEOUT
fi

export PROPERTY_RENTAL_HERMES_PROCESS_MODE=preflight
"$hermes_bin" --in "$repo" --toolsets "$toolsets" prompt-size --json >/dev/null 2>&1 || {
  echo "Hermes plugin capability preflight failed" >&2
  exit 64
}
jq -e '
  .preflight_guard_loaded == true
  and .chat_guard_loaded == false
  and .guard_capabilities == [
    "cumulative_llm_execution",
    "least_privilege_pre_tool_block",
    "least_privilege_tool_execution"
  ]
' "$(jq -r '.budget_path' "$manifest_file")" >/dev/null || {
  echo "Repository-owned Hermes guard did not load" >&2
  exit 64
}

stderr_file="$session_home/hermes.stderr"
export PROPERTY_RENTAL_HERMES_PROCESS_MODE=chat
set +e
"$hermes_bin" chat \
  --provider openai-codex \
  --model gpt-5.6-sol \
  --reasoning "$reasoning" \
  --toolsets "$toolsets" \
  --max-turns 120 \
  --source tool \
  --in "$repo" \
  --quiet \
  --query "$(cat "$task_file")" \
  2>"$stderr_file"
status=$?
set -e

python3 "$guard" finalize-usage "$manifest_file" || {
  cat "$stderr_file" >&2
  echo "Hermes cumulative usage evidence could not be finalized" >&2
  exit 64
}
usage_file="$(jq -er '.usage_path' "$manifest_file")"
jq -e '
  .preflight_guard_loaded == true
  and .chat_guard_loaded == true
  and (.chat_guard_pid | type == "number" and . > 1)
' "$usage_file" >/dev/null || {
  cat "$stderr_file" >&2
  echo "Hermes guard did not attach to the chat process" >&2
  exit 64
}
cat "$stderr_file" >&2
exit "$status"
