# Application
APP_ENV=development
APP_NAME=property-rental-management
APP_SERVICE_NAME=property-rental-backend
APP_BUILD_VERSION=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_TIMEZONE=Asia/Phnom_Penh

# Database
POSTGRES_ADMIN_PASSWORD_FILE=.local/secrets/postgres_admin_password
POSTGRES_MIGRATION_PASSWORD_FILE=.local/secrets/postgres_migration_password
POSTGRES_RUNTIME_PASSWORD_FILE=.local/secrets/postgres_runtime_password
POSTGRES_BACKUP_PASSWORD_FILE=.local/secrets/postgres_backup_password
POSTGRES_RESTORE_PASSWORD_FILE=.local/secrets/postgres_restore_password
POSTGRES_HUMAN_ADMIN_PASSWORD_FILE=.local/secrets/postgres_human_admin_password
POSTGRES_BOOTSTRAP_PASSWORD_FILE=.local/secrets/postgres_bootstrap_password
POSTGRES_PORT=5432
MIGRATION_DATABASE_URL_FILE=/run/secrets/prm_development_migration_database_url
APP_DATABASE_URL_FILE=/run/secrets/prm_development_runtime_database_url
BACKUP_DATABASE_URL_FILE=/run/secrets/prm_development_backup_database_url
RESTORE_DATABASE_URL_FILE=/run/secrets/prm_development_restore_database_url
HUMAN_ADMIN_DATABASE_URL_FILE=/run/secrets/prm_development_human_admin_database_url
BOOTSTRAP_DATABASE_URL_FILE=/run/secrets/prm_development_bootstrap_database_url

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api

# Security
APP_SECRET_KEY_FILE=/run/secrets/prm_development_application_secret
BACKUP_ENCRYPTION_KEY_FILE=/run/secrets/prm_development_backup_encryption_key
BOOTSTRAP_TOTP_KEY_FILE=/run/secrets/prm_development_bootstrap_totp_key
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO