# Application
APP_ENV=development
APP_NAME=property-rental-management
APP_SERVICE_NAME=property-rental-backend
APP_BUILD_VERSION=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_TIMEZONE=Asia/Phnom_Penh

# Database
POSTGRES_ADMIN_PASSWORD=set-a-local-admin-secret
POSTGRES_MIGRATION_PASSWORD=set-a-distinct-local-migration-secret
POSTGRES_RUNTIME_PASSWORD=set-a-distinct-local-runtime-secret
POSTGRES_PORT=5432
MIGRATION_DATABASE_URL=postgresql://prm_migrator:<migration-secret>@127.0.0.1:5432/prm
APP_DATABASE_URL=postgresql://prm_runtime:<runtime-secret>@127.0.0.1:5432/prm
TEST_ADMIN_DATABASE_URL=postgresql://prm_admin:<admin-secret>@127.0.0.1:5432/prm

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api

# Security
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO