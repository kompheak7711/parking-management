{
  "schema_version": 1,
  "roadmap_id": "property-rental-v1",
  "total_tranches": 60,
  "authorization_basis": "Owner durable v1 authorization bounded by authoritative specifications 001-010",
  "global_owner_stops": [
    "unresolved or contradictory business, financial, security, or architecture policy",
    "canonical specification changes without separate authorization",
    "destructive or irreversible data operations",
    "actual production secrets or credentials",
    "production deployment or remote-access activation",
    "suspected secret or customer-data exposure",
    "scope expansion, force-push, history rewriting, or exhausted bounded repairs"
  ],
  "acceptance_profiles": {
    "foundation": [
      "focused deterministic tests",
      "format, lint, strict typecheck, and builds",
      "traceability, scope, secret, dependency, and canonical-integrity gates",
      "independent review",
      "GitHub Actions success"
    ],
    "database": [
      "forward-only migration and constraint tests on disposable real PostgreSQL",
      "domain/service tests",
      "full foundation gates",
      "GitHub Actions success"
    ],
    "api_ui": [
      "API contract and authorization tests",
      "frontend component/accessibility tests",
      "backend and frontend builds",
      "full foundation gates",
      "GitHub Actions success"
    ],
    "financial": [
      "exact-money, idempotency, concurrency, correction, and immutable-history tests",
      "real PostgreSQL tests",
      "API/UI tests where applicable",
      "critical financial suite",
      "full foundation gates",
      "GitHub Actions success"
    ],
    "release": [
      "complete backend, frontend, database, integration, end-to-end, security, dependency, backup/restore, and traceability suites",
      "clean synchronized repository",
      "GitHub Actions success",
      "no unresolved non-protected v1 gap"
    ]
  },
