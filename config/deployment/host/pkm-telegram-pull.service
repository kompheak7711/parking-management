# Telegram bots step 1 (bots plan, shared base): the office job that pulls what waits in the Telegram relay (webhooks, Mini App forms, photos).
# Started every 10 seconds by pkm-telegram-pull.timer; it collects the relay's items every 150 seconds (DL-219). It does nothing while telegram_bots.enabled is false.
[Unit]
Description=CHETANA Parking Telegram pull job
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pkm-ops
Group=pkm-ops
UMask=0077
# /etc/pkm/telegram-jobs.env (mode 0600, owner pkm-ops) holds these lines:
# APP_DATABASE_URL (the runtime login), PRM_PROPERTY_ID and PRM_TELEGRAM_ACTOR_ID
# (the account the jobs run as; it needs the Telegram rights of an Owner or Manager).
# For the Staff bot (step 4a, DL-174) also PRM_TELEGRAM_SERVICE_ACTOR_ID (the service actor the
# HR staff functions need; empty keeps the Staff bot answering "not ready") and
# APP_HR_FILES_DIRECTORY=/var/lib/pkm/hr-files (where caretakers' card photos are kept; the
# office app reads HR files from the same folder).
EnvironmentFile=/etc/pkm/telegram-jobs.env
ExecStart=/opt/pkm/venv/bin/parking-telegram-pull --config /etc/pkm/production-operations.json --property-id ${PRM_PROPERTY_ID} --actor-id ${PRM_TELEGRAM_ACTOR_ID} --service-actor-id=${PRM_TELEGRAM_SERVICE_ACTOR_ID}
StandardOutput=journal
StandardError=journal
TimeoutStartSec=50s
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pkm/status /var/lib/pkm/media -/var/lib/pkm/hr-files
PrivateTmp=true
# The secret files live in /etc/pkm/secrets (kept across restarts); the job sees them at
# /run/secrets, the paths of production-operations.json.
BindReadOnlyPaths=/etc/pkm/secrets:/run/secrets
